HOST=127.0.0.1
PORT=3000
# Browser chatbot testing only; the citizen portal remains available when false.
ENABLE_DEMO=true
# Set true behind a public HTTPS reverse proxy; forward the public Host header.
PUBLIC_HTTPS=false
# Optional: at least 12 characters. If empty, read the generated password locally in data/initial-staff-password.txt.
STAFF_PASSWORD=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Supported Graph API version from your Meta dashboard, including v prefix.
GRAPH_API_VERSION=
